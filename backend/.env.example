# ---- Servidor ----
PORT=4000
# URL pública (https) donde corre ESTE backend. Mercado Pago necesita poder
# pegarle a PUBLIC_BASE_URL + /api/webhooks/mercadopago desde afuera, así que
# en desarrollo local hace falta un túnel (ver README) y en producción, el
# dominio real del backend ya deployado.
PUBLIC_BASE_URL=https://tu-backend.ejemplo.com

# URL pública del FRONT (la app de React), a donde Mercado Pago devuelve al
# cliente después de pagar.
FRONTEND_URL=https://tu-club.ejemplo.com

# ---- Mercado Pago ----
# Tus integraciones > tu app > Credenciales de producción
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tus integraciones > tu app > Webhooks > Configurar notificaciones (clave secreta)
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- WhatsApp Business Cloud API (Meta) ----
WHATSAPP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Si se completa, los mensajes se mandan como plantilla aprobada (necesario
# fuera de la ventana de 24hs desde que el cliente te escribió — el caso
# normal acá). Si se deja vacío, manda texto libre (sólo funciona dentro de
# esa ventana de 24hs). Ver la plantilla sugerida en el README del backend.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es_AR

# ---- Google Sheets (planilla de turnos) ----
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pegá acá el contenido COMPLETO del JSON de la cuenta de servicio, en una
# sola línea (es la forma más simple en Render — no hace falta subir un
# archivo). Alternativa: dejar esto vacío y usar GOOGLE_SERVICE_ACCOUNT_FILE
# más abajo si preferís un archivo (por ejemplo con "Secret Files" de Render,
# o corriendo el backend en tu compu).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# ---- Uso interno ----
# Clave simple para poder consultar GET /api/reservations vos mismo (no la
# usa la página pública). Inventá cualquier string largo y random.
ADMIN_TOKEN=elegí-una-clave-larga-y-random

# ---- Alertas por mail (bloqueos masivos) ----
# Cualquier servidor SMTP sirve — por ejemplo Gmail con una "contraseña de
# aplicación" (no tu contraseña normal): smtp.gmail.com, puerto 587.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-cuenta@gmail.com
EMAIL_PASS=tu-contraseña-de-aplicación
EMAIL_FROM=tu-cuenta@gmail.com
# A dónde llega la alerta — el mail del dueño del club.
EMAIL_TO=dueño@ejemplo.com
